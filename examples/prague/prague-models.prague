revision 1;

// The Prague caches' branded-producer payload types, transcribed from
// corpus/prague/payloads/. Section 1 of the spec declares `Show` once; the
// corpus has a BP, a BO and a Slim variant of it, and this file is the BP and
// Slim halves. bo-models.prague is the other half.
//
// Every tag here is a corpus `[Key(N)]` plus one, because a MessagePack key is
// the tag minus one. Nothing was renumbered and nothing was invented: a member
// this language cannot spell is `reserved` with the ticket that blocks it named
// beside it, never dropped.
//
// What is deliberately absent: the hand-written partial half of each cache type
// (computed members, constructors, indexes -- #25), and the `using` lines the
// corpus needs for its attributes. protop never inspects an annotation's
// contents (section 3), so `using Prague.Feed.Cache.Core;` is not derivable
// from anything written here.
namespace Common.EventApi.Cache.Prague.Models;

import "api-enums.prague";
import "branded.prague";
import "common-feed-enums.prague";
import "virtual-show-entity.prague";

// Venue is corpus/prague/payloads/Venue.cs. It starts at tag 2 because the
// corpus starts at `[Key(1)]`; key 0 is unused there and is unused here.
//
// The corpus writes both members `required`. #12 closed on omitting it and #19
// measured that MessagePack does not enforce it anyway, so the emission drops
// the word. That is the one difference between this declaration and its file.
struct Venue
{
  int64  id   = 2;
  string name = 3;
}

// BPShowCacheItem is the widest type in the corpus: 59 tags, of which
// seven cannot be written.
table BPShowCacheItem
  [cs: DataCache(CacheClassName = nameof(Prague.Models.BPShowCache))]
  [cs: DataCacheTopic("Cache.[v:brandId].Show")]
{
  // Tags this declaration owns and cannot write. `reserved` is how protop
  // keeps a tag it does not transcribe (section 7): the C# member keeps its
  // slot and nothing may reuse it.
  //   12  byte       ProviderId             #32, the closed scalar set
  //   28  DateTime   EventDate              #15, a temporal type
  //   29  DateTime?  ClosedTime             #15, a temporal type
  //   30  DateTime?  EventDateManual        #15, a temporal type
  //   31  DateTime?  ResultedTime           #15, a temporal type
  //   32  DateTime?  SettledTime            #15, a temporal type
  //   51  DateTime?  PurchaseDataLastUpdateAt    #15, a temporal type
  reserved 12, 28..32, 51;

  key int64          event_id                           = 1;
  int64              genre_id                      = 2;
  int64              country_id                         = 3;
  int64              tour_id                          = 4;
  int64?             headliner_id                       = 5;
  int64?             opener_id                       = 6;
  Venue?             venue                              = 7;
  int64?             statistics_center_id               = 8;
  string             name                               = 9;
  string?            provider_source_key                = 10;
  int64              provider_key                       = 11;
  int32              event_type_id                      = 13;
  int32?             listing_id                         = 15;
  bool               is_live                            = 16;
  bool               is_all_resulted                    = 17;
  bool               is_all_settled                     = 18;
  bool               is_manual_changed                  = 19;
  bool?              is_pinned                          = 20;
  bool               is_contains_pending_quotes_with_purchases = 21;
  WatchDogAction     watch_dog_action                   = 22 [cs: DataCacheIndex];
  string?            feed_provider_event_status             = 23;
  EventStatus        event_status                       = 24 [cs: DataCacheIndex];
  EventStatus?       event_status_manual                = 25;
  EventStatus?       event_status_watch_dog             = 26;
  BookingStatus      booking_status                     = 27;
  int32              version                            = 33;
  int64              internal_timestamp                 = 34;
  int64              provider_timestamp                 = 35 [cs: DataCacheIndex(DataCacheIndexType.Range)];
  decimal(4)?        live_limit_manual_single           = 36;
  decimal(4)?        presale_limit_manual_single       = 37;
  decimal(4)?        live_limit_manual_bundle            = 38;
  decimal(4)?        presale_limit_manual_bundle        = 39;
  decimal(4)?        live_purchase_builder_manual_limit      = 40;
  decimal(4)?        presale_purchase_builder_manual_limit  = 41;
  bool               has_ticket_types                      = 45;
  bool               is_settlement_blocked              = 46;
  list<Performer>       performers                            = 47;
  string?            coverage_source                    = 48;
  string?            coverage_level                     = 49;
  int32?             segment_length                      = 50;
  int64              events_hub_received_timestamp_ms   = 52;
  int64              events_hub_produce_timestamp_ms    = 53;
  int32?             event_source                       = 54;
  StaticDataRef      genre                         = 55;
  StaticDataRef      country                            = 56;
  StaticDataRef      tour                             = 57;
  StaticDataRef?     headliner                          = 58;
  StaticDataRef?     opener                          = 59;
}

// BPTicketTypeCacheItem carries the corpus's one composite key and its one alias,
// and the alias is a *part* of the key -- which is why the model resolves a
// key's parts to members rather than to names.
table BPTicketTypeCacheItem
  [cs: DataCache(CacheClassName = nameof(Prague.Models.BPTicketTypeCache))]
  [cs: DataCacheTopic("Cache.[v:brandId].TicketType")]
{
  // Tags this declaration owns and cannot write. `reserved` is how protop
  // keeps a tag it does not transcribe (section 7): the C# member keeps its
  // slot and nothing may reuse it.
  //   16  DateTime?  ClosedTime             #15, a temporal type
  //   17  DateTime?  ResultedTime           #15, a temporal type
  //   18  DateTime?  SettledTime            #15, a temporal type
  reserved 16..18;

  alias ticket_type_id = id [cs: JsonIgnore];
  key key = 1 (event_id, ticket_type_id);
  int64          event_id                 = 2 [cs: DataCacheIndex];
  int64          id                       = 3;
  string         name                     = 4;
  string?        provider_source_key      = 5;
  int64          provider_key             = 6;
  TicketTypeStatus  status                   = 7;
  TicketTypeStatus? status_manual            = 8;
  TicketTypeStatus? status_watch_dog         = 9;
  bool           is_live                  = 10;
  bool           is_listable              = 11;
  bool           is_resulted              = 12;
  bool           is_settled               = 13;
  bool           is_manual_changed        = 14;
  string         assigned_seat_id     = 15;
  double         feed_margin              = 19;
  double         actual_margin            = 20;
  double?        actual_margin_manual     = 21;
  decimal(4)?    limit_manual_single      = 22;
  decimal(4)?    limit_manual_bundle       = 23;
  decimal(4)?    limit_manual_purchase_builder = 24;
  int64          timestamp                = 25;
  list<Quote>      quotes                     = 26;
  list<string>   groups                   = 27;
  Quote?           t                        = 28;
}

// BPSearchCacheItem's key is composite over a scalar and an enum, which is the
// corpus's only non-int64 key part.
//
// Its `/// <summary>TBD: Handling of changes from BO UI</summary>` does not
// survive: protop's lexer discards comments and the model does not carry them.
table BPSearchCacheItem
  [cs: DataCache(CacheClassName = nameof(Prague.Models.BPSearchCache))]
  [cs: DataCacheTopic("Cache.[v:brandId].Search")]
{
  // Tags this declaration owns and cannot write. `reserved` is how protop
  // keeps a tag it does not transcribe (section 7): the C# member keeps its
  // slot and nothing may reuse it.
  //   32  DateTime   EventDate              #15, a temporal type
  reserved 32;

  key key = 1 (event_id, channel_id);
  int64          event_id                           = 2 [cs: DataCacheIndex];
  Channel        channel_id                         = 3 [cs: DataCacheIndex];
  string?        headliner_display_name             = 4;
  int64?         opener_id                       = 5;
  string?        opener_name                     = 6;
  string?        opener_display_name             = 7;
  EventStatus    event_status                       = 8;
  EventStatus?   event_status_manual                = 9;
  EventStatus?   event_status_watch_dog             = 10;
  WatchDogAction watch_dog_action                   = 11;
  BookingStatus  booking_status                     = 12;
  bool           is_top_event                       = 13;
  int32          top_event_order                    = 14;
  int32          active_ticket_types_count             = 15;
  int32          total_ticket_types_count              = 16;
  int32          event_type_id                      = 18;
  int32?         listing_id                         = 19;
  bool           is_live                            = 20;
  string?        live_object_minute                 = 21;
  bool?          is_pinned                          = 22;
  bool           is_contains_pending_quotes_with_purchases = 23;
  bool           is_manual_changed                  = 24;
  string?        headliner_name                     = 25;
  bool           has_is_featured_quotes                = 26;
  int64?         headliner_id                       = 27;
  int32?         tour_display_order               = 28;
  string         event_name                         = 31;
  int64?         timestamp                          = 33;
  int64          genre_id                      = 34;
  string         genre_name                    = 35;
  string?        genre_display_name            = 36;
  int32?         genre_display_order           = 37;
  bool           genre_disabled                = 38;
  int64          country_id                         = 39;
  string         country_name                       = 40;
  string?        country_display_name               = 41;
  int32?         country_display_order              = 42;
  bool           country_disabled                   = 43;
  int64          tour_id                          = 44;
  string         tour_name                        = 45;
  string?        tour_display_name                = 46;
  bool           tour_disabled                    = 47;
  bool           has_ticket_types                      = 48;
}

// BPLiveObjectCacheItem is two members, one of which protop cannot express.
// `IBaseLiveData? LiveObject` is #9's 19-arm union; the tag is reserved and the
// emitted type is a one-member table until #9 rules.
table BPLiveObjectCacheItem
  [cs: DataCache(CacheClassName = nameof(Prague.Models.BPLiveObjectCache))]
  [cs: DataCacheTopic("Cache.[v:brandId].LiveObject")]
{
  // Tags this declaration owns and cannot write. `reserved` is how protop
  // keeps a tag it does not transcribe (section 7): the C# member keeps its
  // slot and nothing may reuse it.
  //   2   IBaseLiveData? LiveObject             #9, unions
  reserved 2;

  key int64 event_id    = 1;
}

// LiveObjectCacheItem is the unbranded twin of BPLiveObjectCacheItem, identical
// but for the cache class name in its annotation.
table LiveObjectCacheItem
  [cs: DataCache(CacheClassName = nameof(LiveObjectCache))]
  [cs: DataCacheTopic("Cache.[v:brandId].LiveObject")]
{
  // Tags this declaration owns and cannot write. `reserved` is how protop
  // keeps a tag it does not transcribe (section 7): the C# member keeps its
  // slot and nothing may reuse it.
  //   2   IBaseLiveData? LiveObject             #9, unions
  reserved 2;

  key int64 event_id    = 1;
}

// SlimQuote is a view of `record Quote`, and the one view in the corpus whose
// source is a record rather than a table. It emits `public class SlimQuote`,
// which is what corpus/prague/payloads/SlimQuote.cs:7 says -- see the note on
// `modifiers` in internal/csharp/csharp.go, and the report on #45.
//
// Its members are `init`-only in the corpus and `get; set;` here. #20 forbids
// emitting an immutable type, so that difference is a ruling rather than a gap.
view SlimQuote of Quote
{
  name;
  is_dynamic;
  timestamp;
  line;
  quotes_actual;
  quotes_fair;
  quotes_manual;
  status;
  status_manual;
  win_status_id;
  win_status_id_manual;
  is_featured;
  is_balanced_line;
  customer_id;
}

// SlimShow is the consumer's narrow read of the Show topic.
//
// Three of its corpus members diverge from the table they are a view of, and a
// view cannot change what it selects (section 5), so the emission follows the
// source and the harness lists them:
//   corpus key 53  `EventSource?` over the table's `int?`   -- a type change
//   corpus key 57  `StaticDataRef` over `StaticDataRef?`    -- a presence change
//   corpus key 58  `StaticDataRef` over `StaticDataRef?`    -- a presence change
// Whether those are deliberate narrowings the language should support, or
// drift between two hand-written files, is not a question this milestone can
// answer from the corpus alone.
view SlimShow of BPShowCacheItem
  [cs: DataCache(CacheClassName = nameof(SlimShowCache))]
  [cs: DataCacheTopic("Cache.[v:brandId].Show")]
{
  // Members of the source this view cannot select:
  //   tag 12  ProviderId               #32, the closed scalar set
  //   tag 28  EventDate                #15, a temporal type
  //   tag 30  EventDateManual          #15, a temporal type

  event_id as id;
  genre_id [cs: DataCacheIndex];
  country_id [cs: DataCacheIndex];
  tour_id [cs: DataCacheIndex];
  headliner_id;
  opener_id;
  statistics_center_id;
  name;
  provider_source_key;
  provider_key;
  event_type_id [cs: DataCacheIndex];
  listing_id;
  is_live [cs: DataCacheIndex];
  is_manual_changed;
  is_pinned;
  is_contains_pending_quotes_with_purchases;
  watch_dog_action [cs: DataCacheIndex];
  event_status [cs: DataCacheIndex];
  event_status_manual;
  event_status_watch_dog;
  booking_status [cs: DataCacheIndex];
  version;
  internal_timestamp [cs: DataCacheIndex(DataCacheIndexType.Range)];
  provider_timestamp;
  live_limit_manual_single;
  presale_limit_manual_single;
  live_limit_manual_bundle;
  presale_limit_manual_bundle;
  live_purchase_builder_manual_limit;
  presale_purchase_builder_manual_limit;
  has_ticket_types;
  coverage_source;
  event_source;
  genre;
  country;
  tour;
  headliner;
  opener;
}

// SlimTicketType selects the source's composite key under a new name, selects the
// field the source's alias points at under the alias's own name, and narrows
// `list<Quote>` to `list<SlimQuote>` -- all three of section 5's view mechanisms in
// eleven lines.
//
// Its last member is the corpus's one array: `SlimQuote[] Quotes`. praguec emits
// `List<SlimQuote>`, which is what the other six collection sites write. Picking
// the array here would be inferring "a view emits T[]" from a single sample,
// and #24 is where that gets ruled.
view SlimTicketType of BPTicketTypeCacheItem
  [cs: DataCache(CacheClassName = nameof(SlimTicketTypeCache))]
  [cs: DataCacheTopic("Cache.[v:brandId].TicketType")]
{
  key as id;
  event_id [cs: DataCacheIndex];
  id as ticket_type_id [cs: DataCacheIndex];
  name;
  status [cs: DataCacheIndex];
  status_manual;
  status_watch_dog;
  is_live [cs: DataCacheIndex];
  is_listable;
  limit_manual_single;
  limit_manual_bundle;
  limit_manual_purchase_builder;
  timestamp [cs: DataCacheIndex(DataCacheIndexType.Range)] [cs: DataCacheFromTimestamp];
  SlimQuote quotes;
}
