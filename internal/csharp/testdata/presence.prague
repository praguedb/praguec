revision 1;

namespace Presence;

record Quote {
  bool live = 1;
}

record Shapes {
  bool           flag       = 1;
  bool?          maybe_flag = 2;
  list<Quote>      quotes       = 3;
  list<Quote>?     maybe_quotes = 4;
  list<Quote?>     quote_maybes = 5;
  list<Quote?>?    both       = 6;
  list<string>   groups     = 7;
  decimal(4)     money      = 8;
  decimal(2)?    maybe_money = 9;
}
