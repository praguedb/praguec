revision 1;

namespace BrandReader.Services.Cache;

import "prague.prague";

view SlimShow of Show {
  event_id as id;

  genre_id;
  country_id;
  tour_id;
  headliner_id;

  venue;
  genre;
}

view SlimQuote of Quote {
  name;
  timestamp;
}

view SlimTicketType of TicketType {
  key as id;

  event_id;
  id as ticket_type_id;

  name;

  status;
  status_manual;
  status_watch_dog;

  limit_manual_single;
  timestamp;

  SlimQuote quotes;
}
